# Keep native desktop bundles identifiable without compiling a new protocol.
if(NOT DEFINED PUBSPEC OR NOT DEFINED BUNDLE OR NOT DEFINED ARCH)
  message(FATAL_ERROR "PUBSPEC, BUNDLE and ARCH are required")
endif()
file(STRINGS "${PUBSPEC}" VERSION_LINE REGEX "^version: *[0-9]+\\.[0-9]+\\.[0-9]+")
if(NOT VERSION_LINE)
  message(FATAL_ERROR "Missing distribution version in ${PUBSPEC}")
endif()
string(REGEX REPLACE "^version: *([0-9]+\\.[0-9]+\\.[0-9]+).*" "\\1" VERSION "${VERSION_LINE}")
string(TOLOWER "${ARCH}" ARCH)
if(ARCH MATCHES "^(amd64|x64|x86_64)$")
  set(ARCH "x86_64")
elseif(ARCH MATCHES "^(aarch64|arm64)$")
  set(ARCH "arm64")
endif()
file(WRITE "${BUNDLE}/VERSION" "${VERSION}\n${ARCH}\n")
