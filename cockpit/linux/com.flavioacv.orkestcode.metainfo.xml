<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (mínimo) para empacotamento Linux. Instalado em
     share/metainfo/. O <id> casa com o app ID e o .desktop. -->
<component type="desktop-application">
  <id>com.flavioacv.orkestcode</id>
  <name>Orkest Code</name>
  <summary>Development environment for AI teams</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <!-- Licença do projeto ainda pendente no monorepo; placeholder válido. -->
  <project_license>MIT</project_license>

  <developer id="com.flavioacv">
    <name>Flavio ACV</name>
  </developer>

  <description>
    <p>
      Orkest é o cliente desktop do Remote Pi: uma GUI multi-pane sobre o motor
      do Pi. Roda agentes (cada um um <code>pi --mode rpc</code>) e terminais
      lado a lado, com árvore de arquivos, worktrees por workspace e
      agendamento de daemons.
    </p>
  </description>

  <launchable type="desktop-id">com.flavioacv.orkestcode.desktop</launchable>

  <url type="homepage">https://github.com/flavioacv/remote_pi</url>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="1.1.0" date="2026-06-12">
      <description>
        <p>Interface fully translated to English.</p>
      </description>
    </release>
    <release version="1.0.0" date="2026-06-12">
      <description>
        <p>Primeira release distribuível do Orkest.</p>
      </description>
    </release>
  </releases>
</component>
