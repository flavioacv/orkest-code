        "generation": 0
      }
    },
    {
      "offsetMs": 500,
      "type": "signal",
      "signal": {
        "source": "structuredHook",
        "phase": "completed",
        "timestampMs": 500,
        "activityId": "subagent-worker-1",
        "summary": "Subagent finished inspection",
        "generation": 0
      }
    },
    {
      "offsetMs": 800,
      "type": "signal",
      "signal": {
        "source": "structuredHook",
