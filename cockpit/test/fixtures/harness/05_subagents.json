  "expectedTransitions": [
    {
      "presence": "none",
      "phase": "idle",
      "terminalStatus": "idle"
    },
    {
      "presence": "attached",
      "phase": "running",
      "terminalStatus": "working",
      "activityId": "root-orchestrator",
